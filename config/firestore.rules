// The current application accesses Firestore through the trusted Node.js Firebase Admin SDK.
// The Admin SDK bypasses these rules. Direct browser access is intentionally denied.
// If you later add Firebase Web SDK authentication, replace these rules with authenticated rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
